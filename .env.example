# このファイルを .env としてこのディレクトリ(zabbix-6.0-custom/)直下にコピーし、
# 環境に合わせて値を設定する(.env はバージョン管理対象外)。scripts/*.sh と
# compose.yml はどちらも自動的に .env を読み込む。
#
#   cp .env.example .env

# --- ビルド対象ソース・ベースイメージ [FR3.1] -----------------------------------------
# Zabbix 6.0ソースの配置先(README.md「Adding the Zabbix source」参照)。
ZABBIX_SRC_DIR=sources/zabbix-6.0.48
# ビルド対象のZabbixバージョン(6.0系列固定。6.0系列を超えてアップグレードしない)。
ZABBIX_VERSION=6.0.48
# ベースイメージのAlpineバージョン(定期的に最新化する運用対象)。
ALPINE_VERSION=3.24
# 対象アーキテクチャ(初回リリースはamd64のみ — BR5.2)。
IMAGE_ARCH=amd64

# --- MySQL接続先 -------------------------------------------------------------------------
# 既定ではCOMPOSE_PROFILES=dev(下記)により同梱の使い捨てdev-mysqlサービスへ接続し、
# `docker compose up -d`だけでフルスタックが手作業なしに立ち上がる(zabbix-5.0-customと
# 同様の挙動)。
#
# 本番環境では必ず、運用者が既存に持つZabbix用MySQLインスタンスを指すよう上書きする
# こと(下記2行とCOMPOSE_PROFILES=dev〈末尾〉を書き換える/削除する)。このプロジェクトは
# 本番DBをコンテナ化・アップグレード・移行しない(主データベースはMySQLのみを対象とする)。
DB_SERVER_HOST=zabbix-dev-mysql
DB_SERVER_PORT=3306
MYSQL_USER=zabbix
MYSQL_PASSWORD=zabbix
MYSQL_DATABASE=zabbix

# 空欄(既定)ならTLSなしで接続する。本番MySQLの証明書が正規CAで検証可能で、
# 暗号化・検証された接続を使いたい場合のみ ZBX_DBTLSCONNECT=required を設定する。
ZBX_DBTLSCONNECT=
ZBX_DBTLSCAFILE=

# --- zabbix-web ------------------------------------------------------------------------
ZABBIX_WEB_PORT=8080
ZBX_SERVER_NAME=
PHP_TZ=UTC

# --- zabbix-agent2 -----------------------------------------------------------------------
ZBX_HOSTNAME=

# --- zabbix-proxy(SQLite3、ローカルバッファのみ。BR5.1の例外規定) ---------------------
# 不要な場合はcompose.ymlのzabbix-proxyサービスをコメントアウトしてよい。
ZABBIX_PROXY_PORT=10051
ZBX_PROXY_HOSTNAME=zabbix-proxy

# --- 公開イメージタグ(compose.ymlのローカルビルド用。Docker Hub公開タグは ---------------
# release_tools.cli generate-tag が別途 BR4.1形式で生成する。ここは開発用ローカルタグ) ---
ZABBIX_IMAGE_TAG=6.0-custom

# --- ScanRunner / SecretScanner ---------------------------------------------------------
REGISTRY_PATH=data/vulnerability-registry.yaml

# --- dev-mysql(検証専用の使い捨てMySQL、本番では一切使わない) -------------------------
# COMPOSE_PROFILES=dev がこのサービスを既定で有効にする(Docker Composeの標準機能。
# `docker compose`実行時に自動で読み込まれる)。本番デプロイではこの行を削除するか
# 別の値に変更し、DB_SERVER_HOST(上記)を運用者の実MySQLへ書き換えること。
COMPOSE_PROFILES=dev
DEV_MYSQL_ROOT_PASSWORD=zabbix-dev-root
DEV_MYSQL_PORT=3306
